<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="ticketscenter" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>vn.ticketscenter.model.identity.User</class>
        <class>vn.ticketscenter.model.identity.Otp</class>
        <class>vn.ticketscenter.model.identity.Organization</class>
        <class>vn.ticketscenter.model.identity.OrganizationMembership</class>
        <class>vn.ticketscenter.model.identity.OrganizationRequest</class>
        <class>vn.ticketscenter.model.event.EventCategory</class>
        <class>vn.ticketscenter.model.event.Event</class>
        <class>vn.ticketscenter.model.event.Zone</class>
        <class>vn.ticketscenter.model.event.Seat</class>
        <class>vn.ticketscenter.model.ticketing.TicketHold</class>
        <class>vn.ticketscenter.model.ticketing.TicketHoldItem</class>
        <class>vn.ticketscenter.model.order.Order</class>
        <class>vn.ticketscenter.model.order.OrderItem</class>
        <class>vn.ticketscenter.model.order.Payment</class>
        <class>vn.ticketscenter.model.order.Coupon</class>
        <class>vn.ticketscenter.model.fulfillment.Ticket</class>
        <class>vn.ticketscenter.model.fulfillment.CheckIn</class>
        <class>vn.ticketscenter.model.fulfillment.RefundRequest</class>
        <class>vn.ticketscenter.model.fulfillment.Refund</class>
        <class>vn.ticketscenter.model.settlement.CommissionRule</class>
        <class>vn.ticketscenter.model.settlement.Settlement</class>
        <class>vn.ticketscenter.model.settlement.SettlementItem</class>
        <class>vn.ticketscenter.model.settlement.Payout</class>
        <class>vn.ticketscenter.model.audit.AuditLog</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
