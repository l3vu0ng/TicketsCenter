# ==========================================
# TicketsCenter — Biến Môi Trường Cấu Hình
# ==========================================

# 1. Cơ sở dữ liệu Microsoft SQL Server
TC_SQL_HOST=localhost
TC_SQL_PORT=1433
TC_SQL_DATABASE=TicketsCenter_Dev
TC_SQL_LOGIN=sa
TC_SQL_PASSWORD=YourSecurePasswordHere!

# 2. Cấu hình Ứng dụng Web
APP_BASE_URL=http://localhost:8080/ticketscenter
APP_ENV=development
APP_SECRET_KEY=ChangeThisInProductionToAStrongRandomSecretKey123!

# 3. Cấu hình Cổng Thanh Toán VNPAY Sandbox
VNPAY_TMN_CODE=TESTCODE
VNPAY_HASH_SECRET=TESTHASHSECRET1234567890
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/ticketscenter/api/payments/vnpay/return

# 4. Cấu hình Dịch vụ Gửi Email (SMTP)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=no-reply@ticketscenter.vn
MAIL_SMTP_PASSWORD=your_app_password
